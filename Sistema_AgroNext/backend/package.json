    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@prisma/client": "6.12.0",
    "argon2": "^0.45.1",
    "prisma": "6.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3"
  }
