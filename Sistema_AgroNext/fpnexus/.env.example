# ───────── FPNexus — variáveis do Docker Compose ─────────
# Copie para .env e preencha. O arquivo .env NÃO deve ir para o repositório.

# Endereço público. Produção: o domínio (HTTPS automático). Local: http://localhost
SITE_ADDRESS=http://localhost
# Cookies Secure: true em produção (HTTPS); false apenas para teste local em http://localhost
COOKIE_SECURE=false

# Banco de dados — use senha longa só com letras e números (vai dentro da URL de conexão)
# Gere com: openssl rand -hex 24
POSTGRES_DB=fpnexus
POSTGRES_USER=fpnexus
POSTGRES_PASSWORD=

# Organização criada no primeiro provisionamento
ORG_INITIAL_NAME="Organização Inicial"
ORG_INITIAL_SLUG=organizacao-inicial

# Sessão e senha
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
PASSWORD_MIN_LENGTH=12

# Documentação OpenAPI em /api/docs
API_DOCS=true

# IA generativa (opcional). Sem chave, as funções generativas aparecem como indisponíveis.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Limites de memória por serviço (ajuste ao plano da VPS)
DB_MEMORY_LIMIT=1g
API_MEMORY_LIMIT=768m
WEB_MEMORY_LIMIT=512m

# A conta administrativa inicial NÃO fica aqui: use o arquivo reservado FPNexus_acesso_inicial.env
# (modelo em FPNexus_acesso_inicial.env.example), lido apenas pelo backend.
